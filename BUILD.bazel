load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Base image
pkg_tar(
    name = "base_files",
    srcs = ["environment.yaml", "setup.sh"],
    package_dir = "/tmp",
)

oci_image(
    name = "llama_3_base",
    base = "@pytorch_base",
    tars = [":base_files"],
    entrypoint = ["/usr/local/bin/entrypoint.sh"],
    cmd = [
        "/bin/bash",
        "-c",
        " ".join([
            "chmod 1777 /tmp &&",
            "/tmp/setup.sh",
        ]),
    ],
)

oci_push(
    name = "push_llama_3_base",
    image = ":llama_3_base",
    repository = "index.docker.io/{user}/llama-3-base",
    remote_tags = ["latest"],
)

# Training image
pkg_tar(
    name = "project_files",
    srcs = glob([
        "scripts/**/*.py",
        "*.py",
        "*.yaml",
        "README.md",
    ], exclude = [
        "bazel-*",
        "__pycache__",
        "*.pyc",
    ]),
    package_dir = "/workspace",
)

oci_image(
    name = "training_image",
    base = ":llama_3_base",
    tars = [":project_files"],
    entrypoint = ["/bin/bash", "-c"],
    cmd = [
        "source ~/.bashrc && python -m scripts.train --model pythia-160m --method dpo --nnodes 1 --nproc_per_node 1",
    ],
)

oci_push(
    name = "push_training_image",
    image = ":training_image",
    repository = "index.docker.io/{user}/llama-3-training",
    remote_tags = ["latest"],
)