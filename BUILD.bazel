load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Base image
pkg_tar(
    name = "base_files",
    srcs = ["environment.yaml"],
    package_dir = "/tmp",
)

oci_image(
    name = "llama_3_base",
    base = "@pytorch_base",
    tars = [":base_files"],
    cmd = [
        "/bin/bash",
        "-c",
        "apt-get update && \
        apt-get install -y --no-install-recommends wget git && \
        rm -rf /var/lib/apt/lists/* && \
        conda install mamba -n base -c conda-forge && \
        mamba env create -f /tmp/environment.yaml && \
        conda init bash && \
        echo 'conda activate llama-3' >> ~/.bashrc && \
        /opt/conda/envs/llama-3/bin/pip install llama-models loguru pydevd-pycharm sentence-transformers tf-keras fire python-dotenv tensorflow_hub nltk openai accelerate bitsandbytes && \
        echo '#!/bin/bash' > /usr/local/bin/entrypoint.sh && \
        echo 'source ~/.bashrc' >> /usr/local/bin/entrypoint.sh && \
        echo 'exec \"\\$@\"' >> /usr/local/bin/entrypoint.sh && \
        chmod +x /usr/local/bin/entrypoint.sh",
    ],
    entrypoint = ["/usr/local/bin/entrypoint.sh"],
)

oci_push(
    name = "push_llama_3_base",
    image = ":llama_3_base",
    repository = "index.docker.io/{user}/llama-3-base",
    remote_tags = ["latest"],
)

# Training image
pkg_tar(
    name = "project_files",
    srcs = glob([
        "scripts/**/*.py",
        "*.py",
        "*.yaml",
        "README.md",
    ], exclude = [
        "bazel-*",
        "__pycache__",
        "*.pyc",
    ]),
    package_dir = "/workspace",
)

oci_image(
    name = "training_image",
    base = ":llama_3_base",
    tars = [":project_files"],
    entrypoint = ["/bin/bash", "-c"],
    cmd = [
        "source ~/.bashrc && python -m scripts.train --model pythia-160m --method dpo --nnodes 1 --nproc_per_node 1",
    ],
)

oci_push(
    name = "push_training_image",
    image = ":training_image",
    repository = "index.docker.io/{user}/llama-3-training",
    remote_tags = ["latest"],
)