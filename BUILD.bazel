load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

# Create a tar archive of your project files
pkg_tar(
    name = "project_files",
    srcs = glob([
        "scripts/**/*.py",
        "*.py",
        "*.yaml",
        "README.md",
    ], exclude = [
        "bazel-*",
        "__pycache__",
        "*.pyc",
    ]),
    package_dir = "/workspace",
)

# Create a tar archive of your environment.yaml file
pkg_tar(
    name = "environment_yaml",
    srcs = ["environment.yaml"],
    package_dir = "/workspace",
)

# Create the custom image
oci_image(
    name = "custom_image",
    base = "@base_image",
    tars = [
        ":project_files",
        ":environment_yaml",
    ],
    cmd = [
        "/bin/bash",
        "-c",
        """
        conda env create -f /workspace/environment.yaml && \
        echo "conda activate llama-3" >> ~/.bashrc && \
        /bin/bash
        """,
    ],
    env = {
        "PYTHONUNBUFFERED": "1",
    },
)

# Push the custom image to Docker Hub
oci_push(
    name = "push_custom_image",
    image = ":custom_image",
    repository = "index.docker.io/{user}/custom_image",
    remote_tags = ["latest"]
)